# Copy to apps/api/.env and fill in. Never commit the real file.

NODE_ENV=development
PORT=4000

# PostgreSQL. DATABASE_URL may be a pooled URL; the unpooled one is used for migrations and scripts.
DATABASE_URL=postgresql://user:password@localhost:5432/love_journal
DATABASE_URL_UNPOOLED=postgresql://user:password@localhost:5432/love_journal

# Auth. Use a long random value, e.g. `openssl rand -base64 48`.
JWT_SECRET=
JWT_EXPIRATION=7d

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Comma-separated web origins allowed to call the API
CORS_ORIGINS=http://localhost:3000

# Shared with apps/web so the API trusts the client IP forwarded by the BFF (rate limiting)
BFF_SHARED_SECRET=

# Seed: creates the admin account if none exists (never overwrites an existing password)
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=

# Destructive: `true` resets all pages to the sample book and also requires
# SEED_CONFIRM_DESTRUCTIVE=yes-wipe-pages
SEED_FORCE_CANONICAL_BOOK=false
SEED_CONFIRM_DESTRUCTIVE=
