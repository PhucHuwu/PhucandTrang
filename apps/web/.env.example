# Copy to apps/web/.env.local and fill in. Never commit the real file.

# API base URL used by the browser and by server-side code / the admin BFF
NEXT_PUBLIC_API_URL=http://localhost:4000/api
BACKEND_INTERNAL_URL=http://localhost:4000/api

# Canonical site URL (Open Graph, robots)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Same value as BFF_SHARED_SECRET in apps/api
BFF_SHARED_SECRET=

# Development only: serve bundled sample data when the API is unreachable
NEXT_PUBLIC_ENABLE_LOCAL_BOOK_FALLBACK=false
